---
import Icon from './Icon.astro';
import { siteConfig } from '../../data/siteConfig';

const whatsappNumber = siteConfig.whatsapp?.number || '51999999999';
const defaultMessage = encodeURIComponent(
  siteConfig.whatsapp?.message || '¡Hola LAVANDA! Deseo solicitar el recojo de mi ropa.'
);
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${defaultMessage}`;
---

<aside class="whatsapp-flotante" aria-label="Contacto por WhatsApp">
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-btn"
    aria-label="Abrir chat de WhatsApp para agendar servicio"
  >
    <!-- Tooltip descriptivo: oculto por defecto, visible únicamente al hacer hover -->
    <span class="whatsapp-tooltip" role="tooltip">
      <span class="punto-estado" aria-hidden="true"></span>
      ¿Dudas? Chatea con nosotros
    </span>

    <span class="icono-circulo">
      <Icon name="whatsapp" size={26} color="#ffffff" />
      <span class="pulso-anillo" aria-hidden="true"></span>
    </span>
  </a>
</aside>

<style>
  .whatsapp-flotante {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 999;
  }

  .whatsapp-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .whatsapp-btn:hover {
    transform: translateY(-4px) scale(1.02);
  }

  /* Tooltip con glassmorphism: OCULTO POR DEFECTO */
  .whatsapp-tooltip {
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--carbon, #2D2D3A);
    font-family: 'Poppins', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 8px 18px;
    border-radius: 50px;
    box-shadow: 0 10px 28px rgba(155, 142, 196, 0.18);
    border: 1px solid var(--lavanda-claro, #E8E3F3);
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    
    /* Estado inicial invisible */
    opacity: 0;
    visibility: hidden;
    transform: translateX(12px);
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s ease;
  }

  /* Se muestra ÚNICAMENTE cuando el cursor está sobre el botón */
  .whatsapp-btn:hover .whatsapp-tooltip,
  .whatsapp-btn:focus-visible .whatsapp-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    pointer-events: auto;
  }

  .punto-estado {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--menta, #7EC8C8);
    box-shadow: 0 0 0 3px rgba(126, 200, 200, 0.35);
    display: inline-block;
  }

  /* Círculo del botón en PALETA LAVANDA */
  .icono-circulo {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--lavanda, #9B8EC4), #7F72B0);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 28px rgba(155, 142, 196, 0.45);
    position: relative;
    flex-shrink: 0;
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .whatsapp-btn:hover .icono-circulo {
    background: linear-gradient(135deg, var(--lavanda-hover, #8A7BB6), #6F62A0);
    box-shadow: 0 14px 34px rgba(155, 142, 196, 0.55);
  }

  /* Pulso animado en color lavanda */
  .pulso-anillo {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid rgba(155, 142, 196, 0.65);
    animation: pulsoLavanda 2.4s infinite;
    pointer-events: none;
  }

  @keyframes pulsoLavanda {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.4);
      opacity: 0;
    }
  }

  @media (max-width: 768px) {
    .whatsapp-flotante {
      bottom: 20px;
      right: 20px;
    }
    .whatsapp-tooltip {
      display: none;
    }
    .icono-circulo {
      width: 52px;
      height: 52px;
    }
  }
</style>
