---
import type { FaqItem } from '../../types/landing';
import Icon from './Icon.astro';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq-accordion">
  {items.map((item) => (
    <details class="faq-item" id={item.id}>
      <summary class="faq-pregunta">
        <span class="faq-texto-pregunta">{item.question}</span>
        <span class="faq-icono-wrapper" aria-hidden="true">
          <Icon name="chevron-down" size={18} color="var(--lavanda, #9B8EC4)" />
        </span>
      </summary>
      <div class="faq-respuesta">
        <p>{item.answer}</p>
      </div>
    </details>
  ))}
</div>

<style>
  .faq-accordion {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faq-item {
    background: #ffffff;
    border: 1px solid var(--lavanda-claro, #E8E3F3);
    border-radius: 18px;
    overflow: hidden;
    transition: var(--transicion-base, all 0.3s ease);
    box-shadow: 0 4px 16px rgba(155, 142, 196, 0.06);
  }

  .faq-item:hover {
    border-color: var(--lavanda, #9B8EC4);
    box-shadow: 0 8px 24px rgba(155, 142, 196, 0.12);
  }

  .faq-item[open] {
    border-color: var(--lavanda, #9B8EC4);
    box-shadow: 0 10px 28px rgba(155, 142, 196, 0.16);
    background: linear-gradient(180deg, #ffffff 0%, #faf8fd 100%);
  }

  .faq-pregunta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 28px;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--carbon, #2D2D3A);
    list-style: none;
    user-select: none;
    gap: 16px;
  }

  .faq-pregunta::-webkit-details-marker {
    display: none;
  }

  .faq-icono-wrapper {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--lavanda-claro, #E8E3F3);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.3s ease;
  }

  .faq-item[open] .faq-icono-wrapper {
    transform: rotate(180deg);
    background: var(--lavanda, #9B8EC4);
  }

  .faq-item[open] .faq-icono-wrapper :global(svg) {
    stroke: #ffffff;
  }

  .faq-respuesta {
    padding: 0 28px 24px;
    animation: fadeInSlide 0.35s ease;
  }

  .faq-respuesta p {
    font-size: 0.98rem;
    opacity: 0.85;
    line-height: 1.65;
    color: var(--carbon, #2D2D3A);
    border-top: 1px dashed var(--lavanda-claro, #E8E3F3);
    padding-top: 16px;
  }

  @keyframes fadeInSlide {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .faq-pregunta {
      padding: 18px 20px;
      font-size: 0.98rem;
    }
    .faq-respuesta {
      padding: 0 20px 20px;
    }
  }
</style>
