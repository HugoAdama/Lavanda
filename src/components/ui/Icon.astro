  | 'subscription'
  | 'bedding'
  | 'sneakers'
  | 'water'
  | 'leaf'
  | 'energy'
  | 'phone'
  | 'mail'
  | 'pin'
  | 'check'
  | 'star'
  | 'basket'
  | 'whatsapp'
  | 'chevron-down'
  | 'menu'
  | 'x'
  | 'shield'
  | 'lock'
  | 'truck';

interface Props {
  name: IconName | string;
  size?: number | string;
  class?: string;
  color?: string;
