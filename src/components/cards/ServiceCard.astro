---
import type { ServiceItem } from '../../types/landing';
import Icon from '../ui/Icon.astro';

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;
---

<article class="tarjeta">
  <div class="icono-wrapper">
    <Icon name={service.icon} size={28} color="var(--lavanda, #9B8EC4)" />
  </div>
  <h3>{service.title}</h3>
  <p>{service.description}</p>
</article>

<style>
  .tarjeta {
    background: #ffffff;
    padding: 32px 26px;
    border-radius: var(--radio, 20px);
    border: 1px solid var(--lavanda-claro, #E8E3F3);
    transition: var(--transicion-base, all 0.3s ease);
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  .tarjeta::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--lavanda, #9B8EC4), var(--menta, #7EC8C8));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .tarjeta:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(155, 142, 196, 0.22);
    border-color: rgba(155, 142, 196, 0.4);
  }

  .tarjeta:hover::after {
    opacity: 1;
  }

  .icono-wrapper {
    width: 58px;
    height: 58px;
    border-radius: 16px;
    background: var(--lavanda-claro, #E8E3F3);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.3s ease;
  }

  .tarjeta:hover .icono-wrapper {
    transform: scale(1.1) rotate(2deg);
    background: #dfd8ee;
  }

  .tarjeta h3 {
    font-size: 1.15rem;
    margin-bottom: 10px;
    font-weight: 600;
  }

  .tarjeta p {
    font-size: 0.92rem;
    opacity: 0.8;
    line-height: 1.55;
  }
</style>
