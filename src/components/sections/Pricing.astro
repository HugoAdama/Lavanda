---
import SectionHeader from '../ui/SectionHeader.astro';
import PricingCard from '../cards/PricingCard.astro';
import Icon from '../ui/Icon.astro';
import { pricingPlans } from '../../data/pricing';
import { trustFeatures } from '../../data/trustBadges';
---

<section id="precios" class="precios-seccion">
  <div class="contenedor">
    <SectionHeader
      badge="Precios"
      title="Precios claros, sin sorpresas"
      subtitle="Elige el plan que mejor se adapta a tu ritmo y estilo de vida."
    />

    <div class="rejilla precios-rejilla">
      {pricingPlans.map((plan, index) => (
        <div data-reveal data-delay={`${(index + 1) * 150}`}>
          <PricingCard plan={plan} />
        </div>
      ))}
    </div>

    <!-- Barra de sellos de confianza y garantías -->
    <div class="confianza-bloque" data-reveal>
      <div class="confianza-grid">
        {trustFeatures.map((item) => (
          <div class="confianza-item">
            <span class="confianza-icono">
              <Icon name={item.icon} size={22} color="var(--lavanda, #9B8EC4)" />
            </span>
            <div>
              <strong>{item.title}</strong>
              <small>{item.subtitle}</small>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .precios-seccion {
    position: relative;
    overflow: hidden;
  }

  .precios-rejilla {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    align-items: stretch;
    gap: 32px;
  }

  /* Bloque de garantías y métodos de pago */
  .confianza-bloque {
    margin-top: 56px;
    background: #ffffff;
    border: 1px solid var(--lavanda-claro, #E8E3F3);
    border-radius: var(--radio, 20px);
    padding: 32px 36px;
    box-shadow: 0 10px 30px rgba(155, 142, 196, 0.08);
  }

  .confianza-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .confianza-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .confianza-icono {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--lavanda-claro, #E8E3F3);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .confianza-item strong {
    display: block;
    font-size: 0.98rem;
    font-family: 'Poppins', sans-serif;
    color: var(--carbon, #2D2D3A);
    margin-bottom: 2px;
  }

  .confianza-item small {
    display: block;
    font-size: 0.88rem;
    opacity: 0.75;
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .confianza-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .confianza-bloque {
      padding: 24px;
      margin-top: 40px;
    }
  }
</style>
